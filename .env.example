# ---- Anthropic (extraction + classification) ----
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model overrides (optional — sensible defaults are baked in)
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-4-6
ANTHROPIC_CLASSIFICATION_MODEL=claude-haiku-4-5-20251001

# ---- Supabase (DB + Auth + Storage) ----
# Project URL + anon key are safe for the browser; the service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

# ---- Inbound email (Tool A primary ingestion) — fill in later ----
# RESEND_API_KEY=
# POSTMARK_INBOUND_TOKEN=
